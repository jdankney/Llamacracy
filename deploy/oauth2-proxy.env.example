# deploy/oauth2-proxy.env  -- copy to deploy/oauth2-proxy.env (gitignored) and fill in.
# oauth2-proxy reads OAUTH2_PROXY_* env vars.

# From the client you register in the NetBird IdP (Pocket-ID / Dex admin UI).
# Redirect URI to register there:  http://<wt0-addr>:4180/oauth2/callback
# (install.sh prints the exact wt0 address.)
OAUTH2_PROXY_CLIENT_ID=
OAUTH2_PROXY_CLIENT_SECRET=

# 32-byte base64 cookie secret. Generate:  openssl rand -base64 32 | tr -- '+/' '-_'
OAUTH2_PROXY_COOKIE_SECRET=
