# deploy/oauth2-proxy.env  -- copy to deploy/oauth2-proxy.env (gitignored) and fill in.
# oauth2-proxy reads OAUTH2_PROXY_* env vars.

# The Llamacracy client from deploy/dex/config.yaml (staticClients). The id is
# fixed; the secret must match the `secret:` in that file
# (openssl rand -hex 32).
OAUTH2_PROXY_CLIENT_ID=llamacracy
OAUTH2_PROXY_CLIENT_SECRET=

# 32-byte base64 cookie secret. install.sh generates this for you on first run.
# Manual:  openssl rand -base64 32 | tr -- '+/' '-_' | tr -d '='
OAUTH2_PROXY_COOKIE_SECRET=
