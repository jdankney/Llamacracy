# deploy/oauth2-proxy.env.example -- deploy/install.sh copies this to
# deploy/oauth2-proxy.env (gitignored), fills in REPLACE_FQDN with your
# NetBird FQDN and generates the cookie + client secrets. Edit by hand only
# if you skipped the installer.
#
# oauth2-proxy reads OAUTH2_PROXY_* env vars; the host-independent settings
# are in oauth2-proxy.cfg.

# Your NetBird FQDN, e.g. myhost.netbird.selfhosted (see `netbird status`).
# Both must use the FQDN, never the raw 100.x address.
OAUTH2_PROXY_OIDC_ISSUER_URL=http://REPLACE_FQDN:5556
OAUTH2_PROXY_REDIRECT_URL=http://REPLACE_FQDN:4180/oauth2/callback

# The Llamacracy client from deploy/dex/config.yaml (staticClients). The id is
# fixed; the secret must match the `secret:` in that file (openssl rand -hex 32).
OAUTH2_PROXY_CLIENT_ID=llamacracy
OAUTH2_PROXY_CLIENT_SECRET=

# 32-byte base64 cookie secret. Generate:  openssl rand -base64 32 | tr -- '+/' '-_'
OAUTH2_PROXY_COOKIE_SECRET=
