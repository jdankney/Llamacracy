# ~/.config/systemd/user/llamacracy-auth.service  (installed by deploy/install.sh,
# which replaces @REPO@ with the absolute path of this checkout)
# oauth2-proxy: the auth edge. Binds the NetBird interface (wt0, a 100.x
# address, discovered at start), authenticates against Llamacracy's own Dex
# (deploy/dex/, also on wt0), and forwards X-Forwarded-{Email,User,
# Preferred-Username} to the app on 127.0.0.1:8000. The Dex issuer and the
# redirect URL are pinned to the NetBird FQDN in deploy/oauth2-proxy.env, so
# only the bind address is discovered here.
[Unit]
Description=Llamacracy auth edge (oauth2-proxy on wt0)
After=llamacracy.service llamacracy-dex.service
Wants=llamacracy.service llamacracy-dex.service
# keep retrying (Restart= below) for as long as NetBird or Dex is down
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=@REPO@
# NetBird brings wt0 up a few seconds after this unit starts at boot, so wait
# for its address (a ConditionPathExists= skip would never be retried) and
# write it, with the port (LLAMACRACY_AUTH_PORT in deploy/oauth2-proxy.env,
# 4180 by default), where oauth2-proxy will read it
ExecStartPre=/bin/sh -c 'for i in $(seq 60); do \
  a=$(ip -4 -o addr show wt0 2>/dev/null | awk "{print \\$4}" | cut -d/ -f1); \
  [ -n "$a" ] && { echo "OAUTH2_PROXY_HTTP_ADDRESS=$a:$${LLAMACRACY_AUTH_PORT:-4180}" > %t/llamacracy-auth.env; exit 0; }; sleep 1; done; \
  echo "wt0 has no address after 60s: is NetBird up?" >&2; exit 1'
# written by ExecStartPre above; `-` so a missing file isn't fatal before it runs
EnvironmentFile=-%t/llamacracy-auth.env
EnvironmentFile=@REPO@/deploy/oauth2-proxy.env
ExecStart=%h/.local/bin/oauth2-proxy --config @REPO@/deploy/oauth2-proxy.cfg
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
