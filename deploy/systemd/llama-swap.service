# ~/.config/systemd/user/llama-swap.service  (installed by deploy/install.sh,
# which replaces @REPO@ with the absolute path of this checkout)
# The inference layer. Owns model loading/swapping; the app never spawns llama-server.
[Unit]
Description=llama-swap (Llamacracy inference layer)
After=network.target

[Service]
Type=simple
WorkingDirectory=@REPO@
ExecStart=%h/.local/bin/llama-swap -config @REPO@/config/llama-swap.yaml -listen 127.0.0.1:8091 -watch-config
Restart=on-failure
RestartSec=3
# llama-server children can briefly spike RAM while a large --no-mmap model loads
OOMScoreAdjust=-200
Nice=-5

[Install]
WantedBy=default.target
