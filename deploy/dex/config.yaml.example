# deploy/dex/config.yaml.example -- deploy/install.sh copies this to
# config.yaml (gitignored), fills in REPLACE_FQDN and generates the client
# secret. You add the users.
#
# Dex is Llamacracy's identity provider. It runs in Docker on the same box and
# is published on the NetBird interface ONLY (see docker-compose.yml), so every
# hop -- friend's browser -> Dex -> oauth2-proxy -> app -- stays inside the
# WireGuard tunnel. Nothing new is exposed to the public internet.
#
# NetBird's own combined server embeds a Dex too, but it only knows about the
# dashboard + CLI clients and has no supported way to add a third one
# (netbirdio/netbird#5335), hence this second, separate instance.

# Must exactly match OAUTH2_PROXY_OIDC_ISSUER_URL in deploy/oauth2-proxy.env.
# REPLACE_FQDN is this peer's NetBird FQDN (`netbird status`), which is
# stable unless the peer is re-enrolled.
issuer: http://REPLACE_FQDN:5556

storage:
  type: sqlite3
  config:
    file: /var/dex/dex.db

web:
  http: 0.0.0.0:5556          # container-internal; compose publishes it on wt0 only

oauth2:
  skipApprovalScreen: true    # one client, trusted users -- skip the consent page
  passwordConnector: local

staticClients:
  - id: llamacracy
    name: Llamacracy
    # Generate:  openssl rand -hex 32
    # The SAME value goes in deploy/oauth2-proxy.env as OAUTH2_PROXY_CLIENT_SECRET.
    secret: "REPLACE_WITH_openssl_rand_hex_32"
    redirectURIs:
      - http://REPLACE_FQDN:4180/oauth2/callback

# Email + password login from the list below. bcrypt each password with
#   deploy/dex/gen-hash.sh 'their-password'
# userID must be unique and stable -- it's what ends up as the OIDC `sub`, which
# is how Llamacracy keys users (email/name can change, sub can't).
enablePasswordDB: true
staticPasswords:
  - email: you@example.com
    username: you
    userID: "u-you"
    hash: "REPLACE_WITH_BCRYPT_HASH"
  # - email: friend@example.com
  #   username: friend
  #   userID: "u-friend"
  #   hash: "REPLACE_WITH_BCRYPT_HASH"
