# Llamacracy configuration. Copy to .env and fill in. .env is gitignored.
# Values here are also the documented defaults for anything optional.

# ---------------------------------------------------------------------------
# Identity
# ---------------------------------------------------------------------------
# Auth is handled entirely by oauth2-proxy (deploy/) against Llamacracy's own
# Dex (deploy/dex/). The app just trusts the X-Forwarded-* headers oauth2-proxy
# sets; the real auth config lives in deploy/oauth2-proxy.env + deploy/dex/.

# Comma-separated emails that get the admin dashboard. Checked against the
# OIDC identity, NOT a database flag.
ADMIN_EMAILS=you@example.com

# When set to 1, the app trusts a fake identity (DEV_EMAIL / DEV_NAME) and
# skips the header check. Never set this in production. Boot fails if
# identity headers are absent and this is unset.
DEV_MODE=
DEV_EMAIL=dev@localhost
DEV_NAME=Dev User

# ---------------------------------------------------------------------------
# Upstream inference
# ---------------------------------------------------------------------------
LLAMASWAP_URL=http://127.0.0.1:8091
APP_BIND_HOST=127.0.0.1
APP_BIND_PORT=8000
# DATABASE_PATH=./data/llamacracy.db
# MODELS_REGISTRY_PATH=./config/models.json

# ---------------------------------------------------------------------------
# Search -- SearXNG, injected on request via a composer toggle. Never
# model-driven (no tool-calling loop): one query, top N snippets, prepended to
# that turn's prompt, one normal inference. Not metered (a local HTTP call).
# ---------------------------------------------------------------------------
SEARXNG_URL=http://127.0.0.1:8085
SEARCH_MAX_RESULTS=4

# ---------------------------------------------------------------------------
# Vision uploads -- on-demand, on disk (never base64 in the DB). A message
# with an attached image routes to that model's `-vision` variant, which
# exists for any inventory entry with a `vision` block (see bench/README.md).
# ---------------------------------------------------------------------------
UPLOAD_DIR=./data/uploads
UPLOAD_MAX_MB=8

# ---------------------------------------------------------------------------
# Compact context -- on demand (button in the context breakdown), never
# automatic. Summarizes everything except the last COMPACT_KEEP_RECENT
# messages into one running note, using the conversation's own model. This is
# a real inference (billed normally).
# ---------------------------------------------------------------------------
COMPACT_KEEP_RECENT=6
COMPACT_SUMMARY_MAX_TOKENS=600

# ---------------------------------------------------------------------------
# Queue
# ---------------------------------------------------------------------------
IDLE_TTL_MINUTES=15
# IDLE_TTL_SECONDS wins over IDLE_TTL_MINUTES when set. Short values (e.g. 60)
# free VRAM/RAM fast but make quick follow-up prompts re-pay the cold load
# (10-25 s for a large model, half-billed to whoever triggers it).
IDLE_TTL_SECONDS=
SMALL_MODEL_FAST_LANE=false
FAST_LANE_VRAM_THRESHOLD_GB=6

# ---------------------------------------------------------------------------
# Metering -- credit = 1 second of exclusive box time
# ---------------------------------------------------------------------------
SESSION_CREDIT_LIMIT=3600        # 60 min of continuous generation per session
WEEKLY_CREDIT_LIMIT=12000        # rolling 7-day; ~3.3x a session
SESSION_WINDOW_HOURS=5
LOAD_TIME_MULTIPLIER=0.5         # model-load seconds billed at half rate
MAX_TOKENS_PER_REQUEST=2048      # hard cap; bounds limit overshoot

# ---------------------------------------------------------------------------
# Cost model -- cost_usd = credits * watts * rate * MARKUP
# ---------------------------------------------------------------------------
# The app records measured mean GPU watts (nvidia-smi) per job and adds
# NON_GPU_LOAD_WATTS for the rest of the box. Without a wall meter, ~100-120 W
# is a reasonable figure for a desktop CPU + board + RAM + NVMe + fans + PSU loss.
NON_GPU_LOAD_WATTS=110
IDLE_WATTS=95                    # whole system, informational (idle is never billed)
MARKUP=1.0                       # raise to 2-3x if invoices should feel non-trivial

# Your electricity price. ELECTRICITY_RATE is a flat $/kWh; if your utility
# has time-of-use pricing, set TOU_SCHEDULE instead: hour-of-day (0-23, local)
# -> $/kWh, and each job is costed at the rate in effect when it ran.
ELECTRICITY_RATE=0.30
# Example three-period TOU day: cheap overnight and midday, expensive 16-21h.
# TOU_SCHEDULE={"0":0.25,"1":0.25,"2":0.25,"3":0.25,"4":0.25,"5":0.25,"6":0.30,"7":0.30,"8":0.30,"9":0.30,"10":0.25,"11":0.25,"12":0.25,"13":0.25,"14":0.30,"15":0.30,"16":0.45,"17":0.45,"18":0.45,"19":0.45,"20":0.45,"21":0.30,"22":0.30,"23":0.30}
TOU_SCHEDULE=
