# Llamacracy configuration. Copy to .env and fill in. .env is gitignored.
# Values here are also the documented defaults for anything optional.

# ---------------------------------------------------------------------------
# Identity
# ---------------------------------------------------------------------------
# Auth is handled entirely by oauth2-proxy (deploy/) against Llamacracy's own
# Dex (deploy/dex/). The app just trusts the X-Forwarded-* headers oauth2-proxy
# sets; the real auth config lives in deploy/oauth2-proxy.env + deploy/dex/.

# Comma-separated emails that get the admin dashboard. Checked against the
# OIDC identity, NOT a database flag.
ADMIN_EMAILS=you@example.com

# When set to 1, the app trusts a fake identity (DEV_EMAIL / DEV_NAME) and
# skips the header check. Never set this in production. Boot fails if
# identity headers are absent and this is unset.
DEV_MODE=
DEV_EMAIL=dev@localhost
DEV_NAME=Dev User

# Where the "Source code" link in the app points. Llamacracy is AGPL-3.0: if
# you run a MODIFIED version for other people, point this at your modified
# source (your fork). Blank hides the link, which is only right if you run it
# unmodified or just for yourself.
SOURCE_URL=https://github.com/jdankney/Llamacracy

# ---------------------------------------------------------------------------
# Upstream inference
# ---------------------------------------------------------------------------
LLAMASWAP_URL=http://127.0.0.1:8091
APP_BIND_HOST=127.0.0.1
APP_BIND_PORT=8000
# DATABASE_PATH=./data/llamacracy.db
# MODELS_REGISTRY_PATH=./config/models.json

# ---------------------------------------------------------------------------
# Search -- SearXNG, behind the composer's Search toggle. A model marked
# `tools: true` in the inventory searches for itself (the agent loop below);
# any other model gets one query built from the message, with the top N
# snippets prepended to that turn. The search call itself is not metered.
# ---------------------------------------------------------------------------
SEARXNG_URL=http://127.0.0.1:8085
SEARCH_MAX_RESULTS=4

# Agent turns: one queued job in which the model may call tools. It keeps
# the GPU slot for the whole turn (and is billed for it), so it is bounded:
AGENT_MAX_STEPS=6               # rounds of tool calls before it must answer
AGENT_MAX_SECONDS=240           # wall clock before it must answer
AGENT_SEARCH_RESULTS=5          # results per web_search call
AGENT_TOOL_RESULT_CHARS=12000   # one tool result is cut past this (~3K tokens)
AGENT_READ_CHARS=10000          # one part of a web page or long document
AGENT_PAGE_MAX_MB=5             # a web page (or online PDF) is cut past this
# Documents on a conversation's branch are sent in full while they fit in
# this share of the model's context; past that, a `tools: true` model gets a
# short stand-in for the biggest and looks things up in them instead.
DOC_INLINE_FRACTION=0.5
# Pictures in agent turns, for `tools: true` models that have a vision
# variant: look again at earlier photos, and (with Search on) find and view
# web images. Those turns run on the -vision entry; false keeps searches on
# the text entry.
AGENT_IMAGES=true
AGENT_IMAGE_MAX_MB=8
# run_python: `tools: true` models calculate in a bubblewrap sandbox (no
# network, no view of the server) using a separate Python that
# deploy/setup-sandbox.sh builds. Offered only when bwrap, prlimit and that
# Python are all present.
PYTHON_TOOL=true
# SANDBOX_PYTHON=./data/sandbox/bin/python
SANDBOX_TIMEOUT_SECONDS=20
SANDBOX_MEMORY_MB=1024
# Study (/study): courses with their own materials and a tutor, on models
# marked `tools`. STUDY_MODEL is the one a new course starts on (default:
# the first heavy-tier tools model); each course then remembers its last.
STUDY=true
# STUDY_MODEL=

# ---------------------------------------------------------------------------
# Uploads -- on disk (never base64 in the DB). A message with an attached
# image routes to that model's `-vision` variant, which exists for any
# inventory entry with a `vision` block (see bench/README.md). Documents
# (PDF, docx, odt, xlsx, pptx, text, ...) work on every model: their text is
# extracted at upload, in a child process with its own memory/CPU caps.
# ---------------------------------------------------------------------------
UPLOAD_DIR=./data/uploads
UPLOAD_MAX_MB=8
DOCUMENT_MAX_MB=25
# text kept from one document, in characters (~3.6 per token); the rest is cut
DOCUMENT_MAX_CHARS=1200000

# ---------------------------------------------------------------------------
# Compact context -- on demand (button in the context breakdown), never
# automatic. Summarizes everything except the last COMPACT_KEEP_RECENT
# messages into one running note, using the conversation's own model. This is
# a real inference (billed normally).
# ---------------------------------------------------------------------------
COMPACT_KEEP_RECENT=6
COMPACT_SUMMARY_MAX_TOKENS=600

# ---------------------------------------------------------------------------
# Queue
# ---------------------------------------------------------------------------
IDLE_TTL_MINUTES=15
# IDLE_TTL_SECONDS wins over IDLE_TTL_MINUTES when set. Short values (e.g. 60)
# free VRAM/RAM fast but make quick follow-up prompts re-pay the cold load
# (10-25 s for a large model, half-billed to whoever triggers it).
IDLE_TTL_SECONDS=
SMALL_MODEL_FAST_LANE=false
FAST_LANE_VRAM_THRESHOLD_GB=6

# ---------------------------------------------------------------------------
# Metering -- credit = 1 second of exclusive box time
# ---------------------------------------------------------------------------
SESSION_CREDIT_LIMIT=3600        # 60 min of continuous generation per session
WEEKLY_CREDIT_LIMIT=12000        # rolling 7-day; ~3.3x a session
SESSION_WINDOW_HOURS=5
LOAD_TIME_MULTIPLIER=0.5         # model-load seconds billed at half rate
MAX_TOKENS_PER_REQUEST=2048      # hard cap; bounds limit overshoot
THINKING_MAX_TOKENS=8192         # cap when Think is on: reasoning + answer share it
API_MAX_TOKENS_PER_REQUEST=8192  # cap on /v1 (coding tools need whole-file replies)

# ---------------------------------------------------------------------------
# Cost model -- cost_usd = credits * watts * rate * MARKUP
# ---------------------------------------------------------------------------
# The app records measured mean GPU watts (nvidia-smi) per job and adds
# NON_GPU_LOAD_WATTS for the rest of the box. Without a wall meter, ~100-120 W
# is a reasonable figure for a desktop CPU + board + RAM + NVMe + fans + PSU loss.
NON_GPU_LOAD_WATTS=110
IDLE_WATTS=95                    # whole system, informational (idle is never billed)
MARKUP=1.0                       # raise to 2-3x if invoices should feel non-trivial

# Your electricity price. ELECTRICITY_RATE is a flat $/kWh; if your utility
# has time-of-use pricing, set TOU_SCHEDULE instead: hour-of-day (0-23, local)
# -> $/kWh, and each job is costed at the rate in effect when it ran.
ELECTRICITY_RATE=0.30
# Example three-period TOU day: cheap overnight and midday, expensive 16-21h.
# TOU_SCHEDULE={"0":0.25,"1":0.25,"2":0.25,"3":0.25,"4":0.25,"5":0.25,"6":0.30,"7":0.30,"8":0.30,"9":0.30,"10":0.25,"11":0.25,"12":0.25,"13":0.25,"14":0.30,"15":0.30,"16":0.45,"17":0.45,"18":0.45,"19":0.45,"20":0.45,"21":0.30,"22":0.30,"23":0.30}
TOU_SCHEDULE=
