# Llamacracy configuration. Copy to .env and fill in. .env is gitignored.
# Values here are also the documented defaults for anything optional.

# ---------------------------------------------------------------------------
# Identity / auth (Phase 6)
# ---------------------------------------------------------------------------
# Auth is handled entirely by oauth2-proxy (deploy/) against Llamacracy's own
# Dex (deploy/dex/). The app just trusts the X-Forwarded-* headers oauth2-proxy
# sets. These three are informational / reserved -- nothing in the app reads
# them today. The real config lives in deploy/oauth2-proxy.cfg + deploy/dex/.
OIDC_ISSUER_URL=http://myhost.netbird.selfhosted:5556
OIDC_CLIENT_ID=llamacracy
OIDC_CLIENT_SECRET=

# Comma-separated emails that get the admin dashboard. Checked against the
# OIDC identity, NOT a database flag.
ADMIN_EMAILS=you@example.com

# When set to 1, the app trusts a fake identity and skips the header check.
# Never set this in production. Boot fails if identity headers are absent
# and this is unset.
DEV_MODE=

# ---------------------------------------------------------------------------
# Upstream inference (Phase 1)
# ---------------------------------------------------------------------------
LLAMASWAP_URL=http://127.0.0.1:8091
APP_BIND_HOST=127.0.0.1
APP_BIND_PORT=8000

# ---------------------------------------------------------------------------
# Queue (Phase 2)
# ---------------------------------------------------------------------------
IDLE_TTL_MINUTES=15
SMALL_MODEL_FAST_LANE=false
FAST_LANE_VRAM_THRESHOLD_GB=6

# ---------------------------------------------------------------------------
# Metering (Phase 3) -- credit = 1 second of exclusive box time
# ---------------------------------------------------------------------------
SESSION_CREDIT_LIMIT=3600        # 60 min of continuous 35B generation
WEEKLY_CREDIT_LIMIT=12000        # rolling 7-day; ~3.3x a session
SESSION_WINDOW_HOURS=5
LOAD_TIME_MULTIPLIER=0.5         # model-load seconds billed at half rate
MAX_TOKENS_PER_REQUEST=2048      # hard cap; bounds limit overshoot

# ---------------------------------------------------------------------------
# Cost model (Phase 3) -- cost_usd = credits * watts * rate * MARKUP
# ---------------------------------------------------------------------------
# No wall meter and no whole-system power sensor on this box. The app records
# measured mean GPU watts (nvidia-smi) per job and adds NON_GPU_LOAD_WATTS.
NON_GPU_LOAD_WATTS=110           # Ryzen 3600 + board + RAM + NVMe + fans + PSU loss
IDLE_WATTS=95                    # whole system, informational (idle is never billed)
MARKUP=1.0

# the utility the TOU plan, climate zone, standard, generation via the local generation provider. Summer (Jun 1 - Oct 31) marginal $/kWh = delivery + CCA gen + PCIA.
# Winter rates not yet known -- seeded with summer (slightly conservative).
ELECTRICITY_RATE=0.456           # flat fallback if TOU_SCHEDULE is unset (= off-peak)
# TOU_SCHEDULE: hour-of-day (0-23, local) -> $/kWh. On-Peak 16-21; Super-Off-Peak
# 0-6 and 10-14; Off-Peak the rest. (Weekend super-off-peak is wider: 0-14.)
TOU_SCHEDULE={"0":0.374,"1":0.374,"2":0.374,"3":0.374,"4":0.374,"5":0.374,"6":0.456,"7":0.456,"8":0.456,"9":0.456,"10":0.374,"11":0.374,"12":0.374,"13":0.374,"14":0.456,"15":0.456,"16":0.665,"17":0.665,"18":0.665,"19":0.665,"20":0.665,"21":0.456,"22":0.456,"23":0.456}
