# Llamacracy configuration. Copy to .env and fill in. .env is gitignored.
# Values here are also the documented defaults for anything optional.

# ---------------------------------------------------------------------------
# Identity / auth (Phase 6)
# ---------------------------------------------------------------------------
# OIDC issuer for your NetBird IdP (embedded Dex or standalone Zitadel).
# Must be the base URL that serves /.well-known/openid-configuration
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Comma-separated emails that get the admin dashboard. Checked against the
# OIDC identity, NOT a database flag.
ADMIN_EMAILS=you@example.com

# When set to 1, the app trusts a fake identity and skips the header check.
# Never set this in production. Boot fails if identity headers are absent
# and this is unset.
DEV_MODE=

# ---------------------------------------------------------------------------
# Upstream inference (Phase 1)
# ---------------------------------------------------------------------------
LLAMASWAP_URL=http://127.0.0.1:8091
APP_BIND_HOST=127.0.0.1
APP_BIND_PORT=8000

# ---------------------------------------------------------------------------
# Queue (Phase 2)
# ---------------------------------------------------------------------------
IDLE_TTL_MINUTES=15
SMALL_MODEL_FAST_LANE=false
FAST_LANE_VRAM_THRESHOLD_GB=6

# ---------------------------------------------------------------------------
# Metering (Phase 3) -- credit = 1 second of exclusive box time
# ---------------------------------------------------------------------------
LOAD_TIME_MULTIPLIER=0.5
MAX_TOKENS_PER_REQUEST=2048
SESSION_CREDIT_LIMIT=            # set from Phase 0 data
WEEKLY_CREDIT_LIMIT=             # set from Phase 0 data
SESSION_WINDOW_HOURS=5

# ---------------------------------------------------------------------------
# Cost model (Phase 3) -- cost_usd = credits * watts * rate * MARKUP
# ---------------------------------------------------------------------------
IDLE_WATTS=100
LOAD_WATTS=350
ELECTRICITY_RATE=                # $/kWh -- the utility Portland, ask the owner
MARKUP=1.0
# Optional TOU table: JSON object of hour-of-day (0-23) -> $/kWh.
# If unset, ELECTRICITY_RATE flat rate is used.
TOU_SCHEDULE=
